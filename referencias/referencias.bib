% =====================================================================================
% BIBLIOGRAFÍA (biblatex + biber)  -  agrega aquí tus referencias y cítalas con \cite{clave}
% =====================================================================================
% REGLAS
%  * Usa una clave única y descriptiva, sin espacios ni acentos:  perez2024deteccion
%  * Los ejemplos de abajo están comentados con «%». Cópialos DEBAJO de esta cabecera, quita el «%»
%    y rellena los datos reales.
%  * Escapa estos caracteres con diagonal invertida:  \&  \%  \_  \#  \$
%  * El TIPO de entrada importa. El sistema de revisión lo lee:
%        @article        -> artículo de REVISTA científica (el que se exige en el estado del arte)
%        @inproceedings  -> artículo de CONGRESO (no se acepta en el estado del arte)
%        @book, @online, @report, @thesis ...
%  * Todo lo que cites debe existir aquí, y todo lo que está aquí debería citarse al menos una vez.
%  * Para páginas de Internet usa @online con url y urldate (fecha de consulta, AAAA-MM-DD).
%
% ---------------------------------------------------------------------------------------
% ARTÍCULO DE REVISTA
% @article{apellido2024tema,
%   author  = {Apellido, Nombre and Apellido2, Nombre2},
%   title   = {Título del artículo},
%   journal = {Nombre de la revista},
%   year    = {2024},
%   volume  = {12},
%   number  = {3},
%   pages   = {45--67},
%   doi     = {10.0000/ejemplo},
% }
%
% ARTÍCULO DE CONGRESO
% @inproceedings{apellido2023tema,
%   author    = {Apellido, Nombre},
%   title     = {Título de la ponencia},
%   booktitle = {Actas del Congreso Internacional de ...},
%   year      = {2023},
%   pages     = {101--108},
%   doi       = {10.0000/ejemplo},
% }
%
% LIBRO
% @book{apellido2020libro,
%   author    = {Apellido, Nombre},
%   title     = {Título del libro},
%   publisher = {Editorial},
%   address   = {Ciudad},
%   year      = {2020},
%   edition   = {3},
% }
%
% PÁGINA DE INTERNET O DOCUMENTACIÓN TÉCNICA
% @online{organizacion2024doc,
%   author  = {Organización},
%   title   = {Título de la página o documento},
%   year    = {2024},
%   url     = {https://www.ejemplo.org/documento},
%   urldate = {2025-01-31},
% }
%
% TESIS
% @thesis{apellido2022tesis,
%   author      = {Apellido, Nombre},
%   title       = {Título de la tesis},
%   type        = {Tesis de maestría},
%   institution = {Universidad},
%   year        = {2022},
% }
